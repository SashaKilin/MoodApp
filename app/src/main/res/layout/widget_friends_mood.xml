<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_friends_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MoodSync"
            android:textColor="#818CF8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="• Друзья"
            android:textColor="#94A3B8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_widget_friends_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Обновлено"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <!-- Friend Slot 1 -->
    <LinearLayout
        android:id="@+id/slot_friend_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/tv_friend_1_emoji"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="😊"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_friend_1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Друг"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_friend_1_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Хорошее"
                android:textColor="#818CF8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_friend_1_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5м"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Friend Slot 2 -->
    <LinearLayout
        android:id="@+id/slot_friend_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/tv_friend_2_emoji"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="🔥"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_friend_2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Друг 2"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_friend_2_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="В работе"
                android:textColor="#818CF8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_friend_2_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15м"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Friend Slot 3 -->
    <LinearLayout
        android:id="@+id/slot_friend_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/tv_friend_3_emoji"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="☕"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_friend_3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Друг 3"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_friend_3_mood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Отдыхает"
                android:textColor="#818CF8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_friend_3_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1ч"
            android:textColor="#64748B"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Empty indicator -->
    <TextView
        android:id="@+id/tv_friends_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="Нажмите, чтобы открыть друзей в MoodSync"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
